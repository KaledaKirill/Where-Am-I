NODE_ENV=development
LOG_LEVEL=info
PORT=3000
PUBLIC_BASE_URL=https://your-service.onrender.com
TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_GROUP_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
GOOGLE_SPREADSHEET_ID=replace_with_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=bot@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"
# Set in GitHub Actions repository Variables; the application does not use it.
RENDER_HEALTH_URL=https://your-service.onrender.com/health
