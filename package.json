{
  "name": "where-am-i",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "webhook:set": "tsx --env-file-if-exists=.env scripts/register-webhook.ts",
    "migrate:locations": "tsx --env-file-if-exists=.env scripts/migrate-locations.ts"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.2",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.4",
    "grammy": "^1.46.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
